{
  "name": "@aspect-build/rust-cross-build",
  "version": "1.0.0",
  "description": "Cross-compile Rust projects without Docker",
  "author": "LongYinan <lynweklm@gmail.com>",
  "homepage": "https://github.com/napi-rs/napi-rs/tree/main/packages/cross-build",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">= 16"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "rust",
    "cross-compile",
    "cross-toolchain",
    "cargo",
    "zigbuild",
    "xwin"
  ],
  "maintainers": [
    {
      "name": "LongYinan",
      "email": "lynweklm@gmail.com",
      "homepage": "https://github.com/Brooooooklyn"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/napi-rs/napi-rs.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/napi-rs/napi-rs/issues"
  },
  "dependencies": {
    "@napi-rs/cross-toolchain": "^1.0.3",
    "colorette": "^2.0.20",
    "obug": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsdown": "^0.17.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsdown",
    "test": "echo 'No tests yet'"
  }
}
